# Required — powers thesis parsing and the agent loop (https://console.groq.com/keys)
GROQ_API_KEY=

# Required for search_news, search_twitter, search_crunchbase, and
# scrape_website (https://console.apify.com/account/integrations)
# YC, Hacker News, GitHub, and SEC EDGAR work without it.
APIFY_API_TOKEN=

# Optional — raises GitHub search rate limit from 10 to 30 req/min
# (https://github.com/settings/tokens — no scopes needed)
GITHUB_TOKEN=

# Optional — polite User-Agent for SEC EDGAR requests (format: "app-name contact@email.com")
SEC_USER_AGENT=

# Optional — Slack incoming webhook; pings you when a run surfaces a company
# never seen in any previous run (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
