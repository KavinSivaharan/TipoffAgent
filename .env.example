# Required — powers thesis parsing and the agent loop (https://console.groq.com/keys)
GROQ_API_KEY=

# Required for search_github, search_news, search_twitter, search_crunchbase,
# and scrape_website (https://console.apify.com/account/integrations)
# YC, Hacker News, and SEC EDGAR work without it.
APIFY_API_TOKEN=

# Optional — polite User-Agent for SEC EDGAR requests (format: "app-name contact@email.com")
SEC_USER_AGENT=
